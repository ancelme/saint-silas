# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional source file for the one-time SQLite-to-PostgreSQL migration.
SQLITE_FILE_PATH="backend/data/st_silas.sqlite"

# PostgreSQL connection URL (required). Use the internal connection URL on Render.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ==========================================
# Security & JWT Token Authentication
# ==========================================
JWT_SECRET="SET_A_UNIQUE_RANDOM_SECRET_FOR_PRODUCTION"
