{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx backend/server.ts",
    "build": "npm run build:backend && vite build --config frontend/vite.config.ts",
    "build:backend": "esbuild backend/server.ts --bundle --platform=node --format=esm --packages=external --outfile=backend/server.bundle.mjs",
    "start": "tsx backend/server.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "clean": "node -e \"const fs=require('fs'); for (const path of ['frontend/dist','backend/server.js']) fs.rmSync(path,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "migrate:sqlite": "tsx backend/scripts/migrate-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "@vercel/node": "^5.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sql.js": "^1.14.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
  }
